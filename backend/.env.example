# --- App ---
PORT=3000
NODE_ENV=development
# URL del frontend (CORS y enlaces)
FRONTEND_URL=http://localhost:5173

# --- Base de datos (docker-compose.yml) ---
DATABASE_URL=postgresql://subs:subs@localhost:5432/subscriptions?schema=public

# --- JWT ---
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_ACCESS_TTL=15m
# Días de vida del refresh token (cookie httpOnly)
REFRESH_TOKEN_TTL_DAYS=7

# --- Mercado Pago ---
# Access token de una aplicación creada DENTRO del usuario VENDEDOR de prueba (APP_USR-...)
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (panel de la app en MP > Webhooks). Vacío = no se valida la firma (solo desarrollo)
MP_WEBHOOK_SECRET=
# URL https a la que MP redirige tras suscribirse (MP rechaza localhost). Ej: tu túnel ngrok del frontend
MP_BACK_URL=https://www.mercadopago.com.co

# --- Admin inicial (seed) ---
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Admin123!

# --- Documentación ---
# Swagger UI en /api/docs (false para desactivarlo, p. ej. en producción)
SWAGGER_ENABLED=true
