# --- App ---
PORT=3000
# En "production" la app NO arranca con secretos de ejemplo, sin MP_WEBHOOK_SECRET o sin https
NODE_ENV=development
# URL del frontend (CORS y enlaces). En producción debe ser https
FRONTEND_URL=http://localhost:5173
# Proxies de confianza delante de la app (0 en local; 1 detrás de un balanceador/CDN)
TRUST_PROXY=0

# --- Base de datos (docker-compose.yml, solo accesible desde localhost) ---
DATABASE_URL=postgresql://subs:subs@localhost:5432/subscriptions?schema=public

# --- JWT ---
# Valor de ejemplo: solo para desarrollo. En producción usa uno aleatorio de 32+ caracteres:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=cambia-esto-por-un-secreto-largo
JWT_ACCESS_TTL=15m
# Días de vida del refresh token (cookie httpOnly)
REFRESH_TOKEN_TTL_DAYS=7

# --- Mercado Pago ---
# Access token de una aplicación creada DENTRO del usuario VENDEDOR de prueba (APP_USR-...)
MP_ACCESS_TOKEN=
# Clave secreta de webhooks (panel de la app en MP > Webhooks). Obligatoria en producción
MP_WEBHOOK_SECRET=
# URL https a la que MP redirige tras suscribirse (MP rechaza localhost). Ej: tu túnel del frontend
MP_BACK_URL=https://www.mercadopago.com.co

# --- Admin inicial (seed) ---
ADMIN_EMAIL=admin@example.com
# Obligatoria para el seed (no hay valor por defecto). En producción: 12+ caracteres
ADMIN_PASSWORD=

# --- Documentación ---
# Swagger UI en /api/docs. Por defecto: activo en desarrollo, desactivado en producción.
# SWAGGER_ENABLED=true
